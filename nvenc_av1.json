{
  "encoder": "nvenc-av1",
  "codec": "av1",
  "_comment": "NVENC AV1 档位 (QVBR 路线, 与 nvenc.json HEVC 同构的恒定质量码控, 依 av1_hw_tuning_guide.md §2.1/§3.1)。AV1 qvbr 为 0-63 刻度 (HEVC 0-51), 现值为 ×63/51≈×1.24 线性换算的标定起点 (23->28, 25->31, 28->35, 26->32), 待 VMAF/SSIMULACRA 重标。10bit 必须 --profile high (rigaya 映射 main=8bit/high=10bit); QVBR/VBR 路线按 NVIDIA 指南沿用 tune hq/uhq (CQP 模式才不写 tune); 非层级 GOP 下 B 帧 <=7 (本机实测); tier/aud/repeat-headers/pic-struct/tf-level/mv-precision 等 HEVC 专属键一律不写。注意: AV1 硬件 RC 仅 CQP/CBR/VBR, QVBR 为 lookahead 软件近似 (本机实测可用)。",
  "profile": {
    "UHQ": {
      "preset": "quality",
      "tune": "uhq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 28,
      "max_bitrate": 100000,
      "vbv_bufsize": 300000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 32,
      "bframes": 7,
      "bref_mode": "middle",
      "refs_forward": 4,
      "refs_backward": 3,
      "gop_len": 0,
      "tile_columns": 2
    },

    "HQ": {
      "preset": "quality",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 31,
      "max_bitrate": 80000,
      "vbv_bufsize": 240000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 32,
      "bframes": 7,
      "bref_mode": "middle",
      "refs_forward": 3,
      "refs_backward": 2,
      "gop_len": 0,
      "tile_columns": 2
    },

    "SMALL": {
      "preset": "quality",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 35,
      "max_bitrate": 40000,
      "vbv_bufsize": 120000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 24,
      "bframes": 7,
      "bref_mode": "each",
      "refs_forward": 3,
      "refs_backward": 2,
      "gop_len": 0,
      "tile_columns": 2
    },

    "FAST": {
      "preset": "default",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 32,
      "max_bitrate": 60000,
      "vbv_bufsize": 240000,
      "aq": true,
      "aq_strength": 4,
      "aq_temporal": true,
      "lookahead": 16,
      "bframes": 4,
      "bref_mode": "each",
      "refs_forward": 2,
      "refs_backward": 1,
      "gop_len": 0,
      "tile_columns": 1
    }
  }
}

{
  "encoder": "nvenc-av1",
  "codec": "av1",
  "_comment": "NVENC AV1 档位 (QVBR 路线, 2026-08-31 实测重标定, 详见 docs/evaluation/av1_calibration.md)。AV1 qvbr 为 0-63 刻度; 本机实测 QVBR 26-30 在噪点内容上输出一致 (~27.2Mbps, XPSNR 42.28) — QVBR lookahead 近似在噪点内容上的质量平台 (CQP26 可达 44.7 但 776Mbps, 不实用), 档位在干净内容上才充分分离 (qvbr 26/30/38 = 27.9/20.4/7.6 Mbps)。tune 在 QVBR 下作用极小 (uhq +0.05 XPSNR), UHQ 保留 tune uhq。10bit 必须 --profile high; QVBR/VBR 路线按 NVIDIA 指南沿用 tune; 非层级 GOP 下 B 帧 <=7 (本机实测)。硬件 AV1 质量带: 噪点 ~42.3 / 干净 ~39.3 XPSNR (SVt-AV1 FAST 档为 43.5/41.1, 软件 AV1 细节与体积均占优)。",
  "quality_check": {
    "_comment": "full 检查附加的 PSNR/SSIM 抽样: 源文件名 sha256 确定性 10 取 1, 仅 <=60s 短视频; setpts=N 帧索引对齐; 阈值防花屏/出错 (非质量门槛); 结果输出 quality_<stem>.json + logs/quality_samples.csv",
    "enabled": true,
    "sample_rate": 10,
    "max_duration_sec": 60,
    "psnr_min_db": 25.0,
    "ssim_min": 0.80,
    "garbage_psnr_db": 12.0,
    "max_garbage_frac": 0.02
  },
  "profile": {
    "UHQ": {
      "preset": "quality",
      "tune": "uhq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 26,
      "max_bitrate": 100000,
      "vbv_bufsize": 300000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 32,
      "bframes": 7,
      "bref_mode": "middle",
      "refs_forward": 4,
      "refs_backward": 3,
      "gop_len": 0,
      "tile_columns": 2
    },

    "HQ": {
      "preset": "quality",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 30,
      "max_bitrate": 80000,
      "vbv_bufsize": 240000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 32,
      "bframes": 7,
      "bref_mode": "middle",
      "refs_forward": 3,
      "refs_backward": 2,
      "gop_len": 0,
      "tile_columns": 2
    },

    "SMALL": {
      "preset": "quality",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 38,
      "max_bitrate": 40000,
      "vbv_bufsize": 120000,
      "aq": true,
      "aq_strength": 6,
      "aq_temporal": true,
      "lookahead": 24,
      "bframes": 7,
      "bref_mode": "each",
      "refs_forward": 3,
      "refs_backward": 2,
      "gop_len": 0,
      "tile_columns": 2
    },

    "FAST": {
      "preset": "default",
      "tune": "hq",
      "profile": "high",
      "level": "6.1",
      "output_depth": 10,
      "qvbr": 34,
      "max_bitrate": 60000,
      "vbv_bufsize": 240000,
      "aq": true,
      "aq_strength": 4,
      "aq_temporal": true,
      "lookahead": 16,
      "bframes": 4,
      "bref_mode": "each",
      "refs_forward": 2,
      "refs_backward": 1,
      "gop_len": 0,
      "tile_columns": 1
    }
  }
}

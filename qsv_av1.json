{
  "encoder": "qsv-av1",
  "codec": "av1",
  "_comment": "QSV AV1 档位 (ICQ 路线, 2026-08-31 实测重标定, 详见 docs/evaluation/av1_calibration.md)。AV1 只有 FF 固定功能路径 (--function-mode FF); ICQ 为 0-255 刻度; B 帧由 --gop-ref-dist 表达 (--bframes 对 AV1 静默无效, 8=甜点); lookahead 新用法 = --la-depth + --extbrc + adaptive_i/b。icq 实测阶梯 (car_6s): 23=28.6Mbps/XPSNR 42.21 (对齐 NVENC UHQ 42.28 带), 26=15.7/41.63, 28=12.4/41.25, 32=7.3/40.17; 干净内容: 22=10.5/38.99, 26=3.5/38.39, 28=2.8/38.12, 32=1.6/37.17。tier/sao/ctu/tskip/weightp/weightb/gpb/open-gop 等 HEVC 专属键一律不写。",
  "quality_check": {
    "_comment": "full 检查附加的 PSNR/SSIM 抽样: 源文件名 sha256 确定性 10 取 1, 仅 <=60s 短视频; setpts=N 帧索引对齐; 阈值防花屏/出错 (非质量门槛); 结果输出 quality_<stem>.json + logs/quality_samples.csv",
    "enabled": true,
    "sample_rate": 10,
    "max_duration_sec": 60,
    "psnr_min_db": 25.0,
    "ssim_min": 0.80,
    "garbage_psnr_db": 12.0,
    "max_garbage_frac": 0.02
  },
  "profile": {
    "UHQ": {
      "icq": 23,
      "profile": "main",
      "level": "auto",
      "output_depth": 10,
      "max_bitrate": 100000,
      "vbv_bufsize": 300000,
      "gop_ref_dist": 8,
      "ref": 8,
      "b_pyramid": true,
      "adaptive_i": true,
      "adaptive_b": true,
      "quality": "best",
      "extbrc": true,
      "mbbrc": true,
      "la_depth": 40,
      "gop_len": 240,
      "async_depth": 3,
      "output_buf_mb": 8,
      "function_mode": "FF",
      "tile_col": 2,
      "tile_row": 0
    },

    "HQ": {
      "icq": 26,
      "profile": "main",
      "level": "auto",
      "output_depth": 10,
      "max_bitrate": 80000,
      "vbv_bufsize": 240000,
      "gop_ref_dist": 8,
      "ref": 8,
      "b_pyramid": true,
      "adaptive_i": true,
      "adaptive_b": true,
      "quality": "best",
      "extbrc": true,
      "mbbrc": true,
      "la_depth": 20,
      "gop_len": 240,
      "async_depth": 3,
      "output_buf_mb": 8,
      "function_mode": "FF",
      "tile_col": 2,
      "tile_row": 0
    },

    "SMALL": {
      "icq": 32,
      "profile": "main",
      "level": "auto",
      "output_depth": 10,
      "max_bitrate": 40000,
      "vbv_bufsize": 120000,
      "gop_ref_dist": 8,
      "ref": 8,
      "b_pyramid": true,
